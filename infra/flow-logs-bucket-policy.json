{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AWSLogDeliveryAclCheck",
      "Effect": "Allow",
      "Principal": {"Service": "delivery.logs.amazonaws.com"},
      "Action": ["s3:GetBucketAcl", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::eventiapp-flow-logs-752279076974-us-east-2",
      "Condition": {
        "StringEquals": {"aws:SourceAccount": "752279076974"},
        "ArnLike": {"aws:SourceArn": "arn:aws:logs:us-east-2:752279076974:*"}
      }
    },
    {
      "Sid": "AWSLogDeliveryWrite",
      "Effect": "Allow",
      "Principal": {"Service": "delivery.logs.amazonaws.com"},
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::eventiapp-flow-logs-752279076974-us-east-2/flowlogs/AWSLogs/752279076974/*",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "752279076974",
          "s3:x-amz-acl": "bucket-owner-full-control"
        },
        "ArnLike": {"aws:SourceArn": "arn:aws:logs:us-east-2:752279076974:*"}
      }
    }
  ]
}
