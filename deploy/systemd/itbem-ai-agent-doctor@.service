[Unit]
Description=ITBEM AI agent role lane preflight (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=itbem-agent-%i
Group=itbem-agent-%i
UMask=0077
WorkingDirectory=/var/lib/itbem-ai-agent/%i
StateDirectory=itbem-ai-agent/%i
Environment=ITBEM_AI_CONCURRENCY=1
Environment=GIT_OPTIONAL_LOCKS=0
EnvironmentFile=/etc/itbem-ai-agent/common.env
EnvironmentFile=/etc/itbem-ai-agent/roles/%i.env
ExecStart=/opt/itbem-ai-agent/current/itbem-ai-agent --doctor
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/itbem-ai-agent/%i
ReadOnlyPaths=/srv/itbem-agent-workspaces/%i
TasksMax=128
LimitNOFILE=4096
MemoryMax=1G
