ITBEM_AI_ROLE=qa
ITBEM_AI_QUEUE_LANE=qa
ITBEM_AI_TRANSPORT=gateway
# Derived, lane-bound token. Never place the backend root callback secret here.
ITBEM_AI_GATEWAY_TOKEN=
ITBEM_AI_WORKSPACES_JSON={}
ITBEM_AI_PROVIDER=minimax
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_KEY=
# Optional semantic browser QA runner. Install it outside every repository,
# set the immutable release digest, and keep this path operator-owned.
ITBEM_STAGEHAND_RUNNER_PATH=
ITBEM_STAGEHAND_RUNNER_SHA256=
