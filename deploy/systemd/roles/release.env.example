ITBEM_AI_ROLE=release_manager
ITBEM_AI_QUEUE_LANE=release
ITBEM_AI_TRANSPORT=gateway
# Derived, lane-bound token. Never place the backend root callback secret here.
ITBEM_AI_GATEWAY_TOKEN=
ITBEM_AI_WORKSPACES_JSON={}
# Separate read-only Source App for registered GitHub workspaces. It cannot
# publish branches, merge, deploy, or read the Reviewer/Release private keys.
ITBEM_GITHUB_SOURCE_APP_ID=
ITBEM_GITHUB_SOURCE_INSTALLATION_IDS=
ITBEM_GITHUB_SOURCE_APP_PRIVATE_KEY_FILE=/etc/itbem-ai-agent/secrets/release/source-github-app.pem
ITBEM_GITHUB_APP_ID=
ITBEM_GITHUB_INSTALLATION_IDS=
ITBEM_GITHUB_APP_PRIVATE_KEY_FILE=/etc/itbem-ai-agent/secrets/release/github-app.pem
