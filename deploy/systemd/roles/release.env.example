ITBEM_AI_ROLE=release_manager
ITBEM_AI_QUEUE_LANE=release
ITBEM_AI_QUEUE_URL=https://sqs.REGION.amazonaws.com/ACCOUNT/itbem-ai-local-prod-release
AWS_CONFIG_FILE=/etc/itbem-ai-agent/secrets/release/aws-config
AWS_PROFILE=itbem-agent-release
AUTOMATION_CALLBACK_SECRET=
ITBEM_AI_WORKSPACES_JSON={}
ITBEM_GITHUB_APP_ID=
ITBEM_GITHUB_INSTALLATION_IDS=
ITBEM_GITHUB_APP_PRIVATE_KEY_FILE=/etc/itbem-ai-agent/secrets/release/github-app.pem
