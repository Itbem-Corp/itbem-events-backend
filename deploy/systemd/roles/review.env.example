ITBEM_AI_ROLE=reviewer
ITBEM_AI_QUEUE_LANE=review
ITBEM_AI_TRANSPORT=gateway
# Derived, lane-bound token. Never place the backend root callback secret here.
ITBEM_AI_GATEWAY_TOKEN=
ITBEM_AI_WORKSPACES_JSON={}
# Separate read-only Source App for checkout synchronization. It cannot
# approve reviews or write checks; keep this key distinct from github-app.pem.
ITBEM_GITHUB_SOURCE_APP_ID=
ITBEM_GITHUB_SOURCE_INSTALLATION_IDS=
ITBEM_GITHUB_SOURCE_APP_PRIVATE_KEY_FILE=/etc/itbem-ai-agent/secrets/review/source-github-app.pem
ITBEM_GITHUB_APP_ID=
ITBEM_GITHUB_INSTALLATION_IDS=
ITBEM_GITHUB_APP_PRIVATE_KEY_FILE=/etc/itbem-ai-agent/secrets/review/github-app.pem
ITBEM_AI_PROVIDER=minimax
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_KEY=
