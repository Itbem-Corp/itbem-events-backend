# Non-secret values shared by every lane. Install as mode 0600 root:root.
AWS_EC2_METADATA_DISABLED=true
AWS_SHARED_CREDENTIALS_FILE=/dev/null
ITBEM_API_BASE_URL=https://api.example.com
# Replace these fail-closed placeholders with the exact infrastructure stack outputs.
ITBEM_AI_INPUT_BUCKET=REPLACE_WITH_INPUT_BUCKET_STACK_OUTPUT
ITBEM_AI_OUTPUT_BUCKET=REPLACE_WITH_OUTPUT_BUCKET_STACK_OUTPUT
