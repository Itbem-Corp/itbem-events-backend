# Non-secret values shared by every lane. Install as mode 0600 root:root.
AWS_REGION=us-east-2
AWS_EC2_METADATA_DISABLED=true
AWS_SHARED_CREDENTIALS_FILE=/dev/null
ITBEM_API_BASE_URL=https://api.example.com
ITBEM_AI_INPUT_BUCKET=itbem-ai-inputs-prod-ACCOUNT-REGION
ITBEM_AI_OUTPUT_BUCKET=itbem-ai-outputs-prod-ACCOUNT-REGION
