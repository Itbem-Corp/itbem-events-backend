# Local-only configuration for scripts/Start-LocalAIAgent.ps1.
# Copy this file to .env.ai.local, fill it locally, and never commit that file.
# The deployed Go binary ignores this file and uses runtime environment variables.

ITBEM_AI_PROVIDER=minimax
MINIMAX_MODEL=MiniMax-M3
# OpenCode Go can instead be selected with:
# ITBEM_AI_PROVIDER=opencode-go
# OPENCODE_GO_MODEL=glm-5.3-flash
# The API key belongs only in the ignored credentials bundle under
# "opencode-go". Do not set OPENCODE_GO_API_KEY in this file or the worker.
# The local control plane reads this ignored file; the local worker calls the
# gateway and never receives a provider API key. Create it before starting:
# DeepSeek and OpenRouter can instead be selected with their current model IDs:
# ITBEM_AI_PROVIDER=deepseek
# DEEPSEEK_MODEL=deepseek-flash
# ITBEM_AI_PROVIDER=openrouter
# OPENROUTER_MODEL=<provider/model-id-from-dashboard>
# Store their disposable local keys only in the ignored credential bundle.
# Optional exact per-model price overrides/extensions must be one line and use
# the same JSON value configured as AUTOMATION_PRICING_JSON in production.
# AUTOMATION_PRICING_JSON={"version":"2026-09-23-local","basis":"official_api_price","models":{"openrouter:vendor/model":{"input_microusd_per_million":250000,"output_microusd_per_million":1500000,"cached_microusd_per_million":25000,"cache_write_microusd_per_million":312500}}}
# New-Item -ItemType Directory -Force .local/ai-provider-credentials | Out-Null
# Set-Content -NoNewline .local/ai-provider-credentials/credentials.json '{"schema_version":1,"credentials":{"minimax":{"api_key":"YOUR_TEST_KEY"}}}'
AI_PROVIDER_CREDENTIALS_LOCAL_FILE=.local/ai-provider-credentials/credentials.json
# Optional provider catalogue refresh cadence. Omit for the 168-hour (weekly)
# default. It updates credential-free model, pricing and capability snapshots.
# AUTOMATION_PROVIDER_CATALOG_SYNC_HOURS=168
ITBEM_AI_GATEWAY_URL=http://localhost:8091/api/internal/automation/inference
# Never set AI_PROVIDER_CREDENTIALS_SECRET_ID locally. It is production-only.
# The local control-plane launcher persists a random signing key under the
# ignored .local directory when this value is omitted. Never pass it to agents.
# AUTOMATION_ATTEMPT_POLICY_SIGNING_KEY=

# Optional: local workspace registry for delivery tasks.
# Managed bases can be cloned/fast-forwarded explicitly with:
# .\scripts\Start-LocalAIAgent.ps1 -SyncWorkspaces
# read_only_fixture_paths is an optional operator-owned allowlist for pinned,
# non-secret content outside Git that isolated worktrees need for validation.
# ITBEM_AI_WORKSPACES_JSON={"dashboard":{"path":"C:\\agent-workspaces\\dashboard","repository_url":"https://github.com/example/dashboard.git","base_branch":"main","capabilities":["repository:read","repository:fetch","worktree:create","patch:apply"],"read_only_fixture_paths":[".contracts/public-schema"]}}
# ITBEM_AI_CONCURRENCY=2
# During the role-lane migration, set both values together for each dedicated
# service. Leave both empty only for the temporary combined-queue worker.
# ITBEM_AI_ROLE=reviewer
# ITBEM_AI_QUEUE_LANE=review

# Optional continuous local-worker launcher. Service mode runs a non-billable
# doctor first and restarts only unexpected worker exits with capped backoff.
# .\scripts\Start-LocalAIAgent.ps1 -KeepAlive

# Optional read-only Stagehand semantic QA. It is disabled unless a registered
# workspace explicitly has qa_semantic_command. Prefer its own scoped key;
# when unset, semantic QA is disabled. It must use its own scoped test key;
# it does not inherit the provider key from the gateway bundle.
# STAGEHAND_QA_ENV=LOCAL
# STAGEHAND_QA_MODEL=MiniMax-M3
# STAGEHAND_QA_BASE_URL=https://api.minimax.io/v1
# STAGEHAND_QA_API_KEY=

# Optional GitHub App integration for an explicitly granted publication.
# These values mint a short-lived installation token at runtime. Do not use a
# personal access token or a personal SSH key, and never commit this file once
# it contains a private key. Newlines in the PEM may be literal or escaped as \n.
# ITBEM_GITHUB_APP_ID=
# ITBEM_GITHUB_INSTALLATION_ID=
# For multiple explicitly approved organization installations, prefer a
# comma-separated allow-list. The webhook rejects every other installation.
# ITBEM_GITHUB_INSTALLATION_IDS=
# ITBEM_GITHUB_APP_PRIVATE_KEY=
# Or mount the PEM from a secrets volume. Do not put the key in source control.
# ITBEM_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/bema-review-bot.pem
# ITBEM_GITHUB_API_BASE_URL=https://api.github.com

# Optional dedicated read-only Source App for repository onboarding and
# workspace synchronization. It must not reuse the publication App identity
# above. The local control-plane launcher imports only these named settings;
# deployed lanes receive them from the secret manager instead.
# ITBEM_GITHUB_SOURCE_APP_ID=
# ITBEM_GITHUB_SOURCE_INSTALLATION_ID=
# ITBEM_GITHUB_SOURCE_INSTALLATION_IDS=
# ITBEM_GITHUB_SOURCE_APP_PRIVATE_KEY=
# ITBEM_GITHUB_SOURCE_APP_PRIVATE_KEY_FILE=/run/secrets/itbem-source-app.pem
# ITBEM_GITHUB_SOURCE_API_BASE_URL=https://api.github.com

# Optional automatic pull-request review ingress. The control plane imports
# only these non-provider settings from .env.ai.local. Keep the secret unique
# to this GitHub webhook and use a narrow comma-separated repository allow-list.
# When either value is absent, POST /api/internal/github/pull-request-review
# remains disabled and returns 404.
# GITHUB_REVIEW_WEBHOOK_SECRET=
# GITHUB_REVIEW_REPOSITORIES=itbem/itbem-events-backend,itbem/dashboard
# An organization wildcard (for example itbem-corp/*) is accepted only when
# the operator intentionally wants every repository in that organization.
