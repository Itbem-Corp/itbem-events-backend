# Local-only configuration for scripts/Start-LocalAIAgent.ps1.
# Copy this file to .env.ai.local, fill it locally, and never commit that file.
# The deployed Go binary ignores this file and uses runtime environment variables.

ITBEM_AI_PROVIDER=minimax
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_KEY=
# A dedicated release_manager/release service must omit provider keys entirely;
# publication is deterministic and its process fails any attempted model call.

# Optional: local workspace registry for delivery tasks.
# Managed bases can be cloned/fast-forwarded explicitly with:
# .\scripts\Start-LocalAIAgent.ps1 -SyncWorkspaces
# ITBEM_AI_WORKSPACES_JSON={"dashboard":{"path":"C:\\agent-workspaces\\dashboard","repository_url":"https://github.com/example/dashboard.git","base_branch":"main","capabilities":["repository:read","repository:fetch","worktree:create","patch:apply"]}}
# ITBEM_AI_CONCURRENCY=2
# During the role-lane migration, set both values together for each dedicated
# service. Leave both empty only for the temporary combined-queue worker.
# ITBEM_AI_ROLE=reviewer
# ITBEM_AI_QUEUE_LANE=review

# Optional continuous local-worker launcher. Service mode runs a non-billable
# doctor first and restarts only unexpected worker exits with capped backoff.
# .\scripts\Start-LocalAIAgent.ps1 -KeepAlive

# Optional read-only Stagehand semantic QA. It is disabled unless a registered
# workspace explicitly has qa_semantic_command. Prefer its own scoped key;
# when unset, the local runner may use MINIMAX_API_KEY already provided to the
# worker. The local runner defaults to the official compatible API endpoint.
# STAGEHAND_QA_ENV=LOCAL
# STAGEHAND_QA_MODEL=MiniMax-M3
# STAGEHAND_QA_BASE_URL=https://api.minimax.io/v1
# STAGEHAND_QA_API_KEY=

# Optional GitHub App integration for an explicitly granted publication.
# These values mint a short-lived installation token at runtime. Do not use a
# personal access token or a personal SSH key, and never commit this file once
# it contains a private key. Newlines in the PEM may be literal or escaped as \n.
# ITBEM_GITHUB_APP_ID=
# ITBEM_GITHUB_INSTALLATION_ID=
# For multiple explicitly approved organization installations, prefer a
# comma-separated allow-list. The webhook rejects every other installation.
# ITBEM_GITHUB_INSTALLATION_IDS=
# ITBEM_GITHUB_APP_PRIVATE_KEY=
# Or mount the PEM from a secrets volume. Do not put the key in source control.
# ITBEM_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/bema-review-bot.pem
# ITBEM_GITHUB_API_BASE_URL=https://api.github.com

# Optional automatic pull-request review ingress. The control plane imports
# only these non-provider settings from .env.ai.local. Keep the secret unique
# to this GitHub webhook and use a narrow comma-separated repository allow-list.
# When either value is absent, POST /api/internal/github/pull-request-review
# remains disabled and returns 404.
# GITHUB_REVIEW_WEBHOOK_SECRET=
# GITHUB_REVIEW_REPOSITORIES=itbem/itbem-events-backend,itbem/dashboard
# An organization wildcard (for example itbem-corp/*) is accepted only when
# the operator intentionally wants every repository in that organization.
