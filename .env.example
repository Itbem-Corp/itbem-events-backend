# ─────────────────────────────────────────────
#  itbem-events-backend — environment template
#  Copy to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────

# Server
PORT=8080
# ENV must be set to any non-empty value in production to skip loading .env
ENV=production

# AWS — general
AWS_REGION=us-east-1

# AWS Cognito (auth)
COGNITO_AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# AWS S3 (file storage)
S3_CLIENT_ID=
S3_CLIENT_SECRET=
AWS_BUCKET_NAME=

# PostgreSQL
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=events_db
DB_PORT=5432
DB_TIMEZONE=UTC

# Redis / Valkey
REDIS_HOST=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS — extra origins appended to the hardcoded production list.
# Use for local development. Comma-separated. Leave empty in production.
# CORS_ALLOW_ORIGINS=http://localhost:4321,http://localhost:3000
