# ─────────────────────────────────────────────
#  itbem-events-backend — environment template
#  Copy to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────

# Server
PORT=8080
# Leave ENV empty locally so the backend loads this .env file and uses local defaults.
# Production injects a non-empty ENV and all variables through the runtime.
ENV=
SOURCE_REVISION=local

# AWS SDK — default credential chain
AWS_REGION=us-east-1
# Optional but recommended when S3 differs from Cognito/SQS. If omitted, the
# backend verifies the bucket region once at startup and corrects stale values.
S3_REGION=
# Custom S3-compatible endpoint (LocalStack/MinIO). Leave blank for AWS.
S3_ENDPOINT=
S3_USE_PATH_STYLE=false
# Optional legacy URL identity. The backend uses this to turn previously
# stored CDN URLs back into canonical keys before issuing private signed URLs.
# It does not make CloudFront an authorization boundary.
CDN_BASE_URL=
# Prefer an AWS profile, SSO/workload identity, or the standard variables below.
# AWS_PROFILE=eventiapp-local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# AWS Cognito — backend JWT issuer and Admin API
COGNITO_AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# The Cognito App Client belongs in dashboard-ts/.env.local, not this backend file.

# Legacy static AWS credentials only. New environments should leave these empty.
# A pair is used only when both its ID and secret are present.
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# AWS S3 (file storage)
AWS_BUCKET_NAME=
TENANT_BUCKET_MAP=eventiapp=eventiapp-media,itbem=itbem-media,cafettonhouse=cafettonhouse-media
# Legacy static AWS credentials for S3/SQS only.
S3_CLIENT_ID=
S3_CLIENT_SECRET=

# PostgreSQL
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=events_db
DB_PORT=5432
DB_TIMEZONE=UTC
# Optional: silent, error, warn, info. Defaults to info locally and warn when ENV is set.
DB_LOG_LEVEL=

# Redis / Valkey
REDIS_HOST=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Media processing queues (optional locally; configure in deployed environments)
SQS_IMAGE_QUEUE_URL=
SQS_VIDEO_QUEUE_URL=
SQS_WORKER_QUEUE_URL=
# ITBEM-only pull queue consumed by the local AI agent. Never reuse the
# EventiApp worker or media queues.
SQS_AUTOMATION_QUEUE_URL=
AUTOMATION_INPUT_BUCKET=
AUTOMATION_OUTPUT_BUCKET=
SQS_ENDPOINT=
SNS_WORKER_TOPIC_ARN=
INTERNAL_API_SECRET=
INTERNAL_API_SECRET_PREVIOUS=
# Generate independently with: openssl rand -hex 32. Configure only on the
# local agent and backend runtime; rotate with the previous value.
AUTOMATION_CALLBACK_SECRET=
AUTOMATION_CALLBACK_SECRET_PREVIOUS=

# Dedicated signed public-access secrets. Production/staging require all three
# signing/callback values to be at least 32 bytes and mutually different.
# Generate each independently with: openssl rand -hex 32
EVENT_PREVIEW_SECRET=
EVENT_ACCESS_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS — extra origins appended to the hardcoded production list.
# Use for local development. Comma-separated. Leave empty in production.
CORS_ALLOW_ORIGINS=http://localhost:4321,http://localhost:3000
TENANT_HOST_MAP=localhost=*,api.eventiapp.com.mx=eventiapp,api.itbem.com.mx=itbem,api.cafettonhouse.com=cafettonhouse
